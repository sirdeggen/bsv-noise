# Explicit mainnet opt-in. Copy the four lines you need into /opt/bsv-noise/.env
# (or export them) and recreate the container. The process will not broadcast
# on mainnet unless ALLOW_MAINNET_BROADCAST is true.
#
# Fund the identity on Message Box / PeerPay first (IMPORT_FUNDING=true with
# BROADCAST still false is a reasonable "paused until funded" step). Then
# turn broadcast on.

NETWORK=main
ALLOW_MAINNET_BROADCAST=true
IMPORT_FUNDING=true
BROADCAST=true
