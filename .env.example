# Copy to a secret store or a root-only .env next to docker-compose.yml.
# Do not commit real values. Provide the private key via SERVER_PRIVATE_KEY_FILE
# (preferred) or SERVER_PRIVATE_KEY. Never commit either.

# SERVER_PRIVATE_KEY=
SERVER_PRIVATE_KEY_FILE=/run/secrets/server_private_key

# Safe defaults: BSV testnet, no broadcast, no funding import.
# Mainnet broadcast requires ALL of: NETWORK=main, ALLOW_MAINNET_BROADCAST=true,
# BROADCAST=true. The process will refuse mainnet broadcast without the flag.
NETWORK=test
BROADCAST=false
ALLOW_MAINNET_BROADCAST=false
IMPORT_FUNDING=false
CONTROLLED_RECIPIENTS=true

LISTEN=0.0.0.0:8741
DATA_DIR=/data
TARGET_TPS=0.5
MESSAGE_BOX_URL=https://messagebox.bsvblockchain.tech
MESSAGE_BOX=payment_inbox

# Optional gate for / and /api/stats. Leave empty to leave the console readable.
# CONSOLE_TOKEN=
# CONSOLE_TOKEN_FILE=
# Optional gate for /metrics and /readyz.
# METRICS_TOKEN=
# METRICS_TOKEN_FILE=

# Safety caps (sats). Adjust to taste; defaults are conservative for a new wallet.
# DAILY_SPEND_CAP=100000000
# DAILY_FEE_CAP=1000000
# RESERVE_SAT=50000
# MAX_IN_FLIGHT=4
# DUST_SAT=1000
# TARGET_CHANGE_OUTPUTS=8
# MIN_DESIRED_UTXO_VALUE=1000
# UTXO_STRATEGY=privacy
# AMOUNT_DISTRIBUTION=realistic

# Broadcaster config is built in: primary Arcade (toolbox default arcade-v2-us-1),
# GorillaPool Arcade (https://arcade.gorillapool.io) as a status/rebroadcast
# fallback, and WhatsOnChain as a failover. TAAL ARC and GorillaPool classic
# ARC are disabled. Leave these unset unless you have a reason to override
# the primary ARC endpoint; the token is never logged.
# ARC_URL=
# ARC_TOKEN=
